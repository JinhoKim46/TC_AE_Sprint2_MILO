# Copy to .env (git-ignored) and fill in. Placeholders only: never commit a real value.

# OpenRouter is the only model provider (SPEC D3, D53). Leave empty here.
OPENROUTER_API_KEY=

# The owner's OpenRouter balance in USD at setup; src/milo/spend.py keeps a 1.00 USD reserve (SPEC D18).
MILO_BUDGET_USD=

# Flask session key for create_app. At least 32 bytes in production; never reuse an example value (SPEC D137).
MILO_SECRET_KEY=

# 0 or 1. Contract mode ignores it (SPEC D2).
MILO_ADVANCED_RAG=0

# test or prod. Tests and evals refuse prod (SPEC D76). Only create_app reads the prod URL.
MILO_ENV=test

# Supabase session-pooler connection strings (SPEC D127). Read only by src/milo/settings.py.
# Form: postgresql://milo_app.<project-ref>:<password>@<pooler-host>:5432/postgres
SUPABASE_test_session_pooler=
SUPABASE_prod_session_pooler=

# Unset by default. Only `make final-test` sets MILO_FINAL=1 (SPEC 10.1).
# MILO_FINAL=

# D153: the two session-pooler strings above are administrative (role postgres): migrate, reset, RLS test only.
# The app connects with its own role strings, set by the owner after the role passwords exist (checklist item 10).
SUPABASE_test_app_pooler=postgresql://milo_app.<project-ref>:<password>@<pooler-host>:5432/postgres
SUPABASE_prod_app_pooler=
SUPABASE_prod_operator_pooler=
